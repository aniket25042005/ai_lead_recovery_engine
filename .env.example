PROJECT_NAME="Zizzet AI Lead Recovery Engine"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Primary Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/zizzet_recovery"

# SQLite Fallback (Auto-engaged if local Postgres instance is offline during development/testing)
SQLITE_FALLBACK_URL="sqlite:///./zizzet_recovery.db"
FALLBACK_TO_SQLITE_ON_DB_ERROR=true

# LLM Provider: "mock" | "gemini" | "openai"
# Set to "mock" for zero-cost, deterministic tests and evaluation
# Set to "gemini" or "openai" when providing live API keys
LLM_PROVIDER="mock"

# Google Gemini Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# OpenAI Settings
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Engine Controls
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=25
PROMPT_VERSION="v1.0"
LOG_LEVEL="INFO"
